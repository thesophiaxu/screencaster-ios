+use std::sync::atomic::{AtomicU64, Ordering};
+pub static COUNTERS: [AtomicU64; 24] = [const { AtomicU64::new(0) }; 24];
+pub fn add(i: usize, n: u64) { COUNTERS[i].fetch_add(n, Ordering::Relaxed); }
+pub fn set(i: usize, n: u64) { COUNTERS[i].store(n, Ordering::Relaxed); }
+#[unsafe(no_mangle)]
+pub extern "C" fn phantom_tcp_counter(i: usize) -> u64 { COUNTERS.get(i).map(|x| x.load(Ordering::Relaxed)).unwrap_or(0) }
