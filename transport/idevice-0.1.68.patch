+// Move a root NSData out of the plist object table. The generic archive decoder
+// clones it while retaining the table, creating another full screenshot allocation.
+fn decode_payload(bytes: &[u8]) -> Result<Value, IdeviceError> {
+    if let Ok(Value::Dictionary(mut archive)) = Value::from_reader(Cursor::new(bytes)) {
+        let root = archive.get("$top").and_then(Value::as_dictionary)
+            .and_then(|d| d.get("root")).and_then(Value::as_uid).map(|u| u.get() as usize);
+        if let (Some(mut objects), Some(mut index)) = (archive.remove("$objects").and_then(Value::into_array), root) {
+            for _ in 0..objects.len() {
+                match objects.get(index) {
+                    Some(Value::Uid(uid)) => { index = uid.get() as usize; continue; }
+                    Some(Value::Data(_)) => return Ok(std::mem::replace(&mut objects[index], Value::Boolean(false))),
+                    Some(Value::Dictionary(d)) => {
+                        let data_class = d.get("$class").and_then(Value::as_uid)
+                            .and_then(|u| objects.get(u.get() as usize)).and_then(Value::as_dictionary)
+                            .and_then(|c| c.get("$classname")).and_then(Value::as_string)
+                            .is_some_and(|c| c.contains("Data"));
+                        if data_class {
+                            if let Value::Dictionary(d) = &mut objects[index] {
+                                if let Some(Value::Data(data)) = d.remove("NS.data") { return Ok(Value::Data(data)); }
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+                break;
+            }
+        }
+    }
+    Ok(ns_keyed_archive::decode::from_bytes(bytes).map_err(super::errors::DvtError::from)?)
+}
