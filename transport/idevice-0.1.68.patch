+//! Bounded, serial screenshot capture for Phantom's VPN extension.
+use std::{ptr::null_mut,time::{Duration,Instant}};
+use idevice::{IdeviceError,ReadWrite,provider::RsdProvider,core_device::CoreDeviceServiceClient};
+use crate::{IdeviceFfiError,ffi_err,run_sync,run_sync_local,core_device_proxy::AdapterHandle,rsd::RsdHandshakeHandle};
+use plist::Value;
+
+type Client=CoreDeviceServiceClient<Box<dyn ReadWrite>>;
+pub struct PhantomScreenHandle { info: Client, capture: Client }
+
+fn active_display(info: &Value) -> Option<(String,u32,String)> {
+    let ds=info.as_dictionary()?.get("displays")?.as_array()?;
+    let mut candidates=ds.iter().filter_map(|d| {
+        let d=d.as_dictionary()?;
+        if d.get("external")?.as_boolean()? || !d.get("active")?.as_boolean()? || d.get("backlightState")?.as_string()? != "activeOn" {return None;}
+        Some((d.get("uniqueId")?.as_string()?.to_owned(),u32::try_from(d.get("displayId")?.as_unsigned_integer()?).ok()?,d.get("currentOrientation")?.as_string()?.to_owned()))
+    });
+    let first=candidates.next()?;
+    if candidates.next().is_some() {None} else {Some(first)}
+}
+
+/// Safety: caller owns valid adapter/handshake handles and writable result pointer.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn phantom_screen_connect(provider:*mut AdapterHandle,handshake:*mut RsdHandshakeHandle,result:*mut *mut PhantomScreenHandle)->*mut IdeviceFfiError {
+    if provider.is_null() || handshake.is_null() || result.is_null(){return ffi_err!(IdeviceError::FfiInvalidArg);}
+    let connected: Result<PhantomScreenHandle,IdeviceError>=run_sync_local(async {
+        let provider=unsafe{&mut (*provider).0};let rsd=unsafe{&(*handshake).0};
+        let mut clients=Vec::new();
+        for name in ["com.apple.coredevice.deviceinfo","com.apple.coredevice.screencaptureservice"] {
+            let port=rsd.services.get(name).ok_or(IdeviceError::ServiceNotFound)?.port;
+            clients.push(CoreDeviceServiceClient::new(provider.connect_to_service_port(port).await?).await?);
+        }
+        let capture=clients.pop().unwrap();let info=clients.pop().unwrap();Ok(PhantomScreenHandle{info,capture})
+    });
+    match connected {Ok(h)=>{unsafe{*result=Box::into_raw(Box::new(h))};null_mut()},Err(e)=>ffi_err!(e)}
+}
+/// Safety: pointers are valid; returned bytes are freed with idevice_data_free.
+/// A null/zero image on success means no unambiguous active panel, or a fold/rotation race.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn phantom_screen_take(handle:*mut PhantomScreenHandle,data:*mut *mut u8,len:*mut usize,display:*mut u32,lookup_ms:*mut f64)->*mut IdeviceFfiError {
+    if handle.is_null()||data.is_null()||len.is_null()||display.is_null()||lookup_ms.is_null(){return ffi_err!(IdeviceError::FfiInvalidArg);}
+    unsafe{*data=null_mut();*len=0;*display=0;*lookup_ms=0.0;}
+    let h=unsafe{&mut *handle};
+    let response:Result<Option<(Vec<u8>,u32,f64)>,IdeviceError>=run_sync(async {
+        let work=async {
+            let start=Instant::now();
+            let before=h.info.invoke("com.apple.coredevice.feature.getdisplayinfo",None).await?;
+            let Some(selected)=active_display(&before) else{return Ok(None)};
+            let first_lookup=start.elapsed().as_secs_f64()*1000.0;
+            let mut input=plist::Dictionary::new();input.insert("displayUniqueID".into(),selected.0.clone().into());input.insert("requestedFormat".into(),"png".into());
+            let output=h.capture.invoke_with_plist_action("com.apple.coredevice.feature.capturescreenshot",input,"com.apple.coredevice.action.capturescreenshot").await?;
+            let mut output=output.into_dictionary().ok_or_else(||IdeviceError::UnexpectedResponse("screenshot output is not a dictionary".into()))?;
+            let bytes=output.remove("image").and_then(Value::into_data).ok_or_else(||IdeviceError::UnexpectedResponse("missing screenshot image".into()))?;
+            if bytes.len()>32*1024*1024{return Err(IdeviceError::UnexpectedResponse("screenshot exceeds 32 MiB budget".into()));}
+            let start=Instant::now();
+            let after=h.info.invoke("com.apple.coredevice.feature.getdisplayinfo",None).await?;
+            let lookup=first_lookup+start.elapsed().as_secs_f64()*1000.0;
+            if active_display(&after).as_ref()!=Some(&selected){return Ok(None);}
+            Ok(Some((bytes,selected.1,lookup)))
+        };
+        tokio::time::timeout(Duration::from_secs(8),work).await.map_err(|_|IdeviceError::UnexpectedResponse("active-display screenshot timed out".into()))?
+    });
+    match response {
+        Ok(Some((bytes,id,ms)))=>{let mut bytes=bytes.into_boxed_slice();unsafe{*len=bytes.len();*data=bytes.as_mut_ptr();*display=id;*lookup_ms=ms;}std::mem::forget(bytes);null_mut()},
+        Ok(None)=>null_mut(),Err(e)=>ffi_err!(e)
+    }
+}
+/// Safety: handle is null or owned by caller and no capture is in progress.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn phantom_screen_free(handle:*mut PhantomScreenHandle){if !handle.is_null(){drop(unsafe{Box::from_raw(handle)});}}
