+#[cfg(test)]
+mod phantom_regression {
+    use super::*;
+    #[derive(Debug, Default)]
+    struct BackpressuredWriter { blocked_once: bool, bytes: Vec<u8> }
+    impl AsyncRead for BackpressuredWriter {
+        fn poll_read(self: Pin<&mut Self>, _: &mut Context<'_>, _: &mut ReadBuf<'_>) -> Poll<std::io::Result<()>> { Poll::Pending }
+    }
+    impl AsyncWrite for BackpressuredWriter {
+        fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, data: &[u8]) -> Poll<std::io::Result<usize>> {
+            if !self.blocked_once { self.blocked_once=true; cx.waker().wake_by_ref(); return Poll::Pending; }
+            self.bytes.extend_from_slice(data); Poll::Ready(Ok(data.len()))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> { Poll::Ready(Ok(())) }
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<std::io::Result<()>> { Poll::Ready(Ok(())) }
+    }
+    #[tokio::test]
+    async fn phantom_pending_write_must_not_duplicate_record() {
+        let keys = KeyBlock { client_mac_key: vec![0;48], server_mac_key: vec![0;48], client_write_key: vec![0;32], server_write_key: vec![0;32], suite: CipherSuite::Aes256CbcSha384 };
+        let mut stream = TlsPskStream { inner: BackpressuredWriter::default(), keys, write_seq:0, read_seq:0, read_buf:vec![], pending_record:vec![], pending_record_total:0, write_buf:vec![] };
+        stream.write_all(b"one packet").await.unwrap(); stream.flush().await.unwrap();
+        let mut offset=0; let mut records=0;
+        while offset < stream.inner.bytes.len() { let bytes=&stream.inner.bytes; let len=u16::from_be_bytes([bytes[offset+3],bytes[offset+4]]) as usize; offset+=5+len; records+=1; }
+        assert_eq!(records,1,"Backpressure must not send the same plaintext twice");
+    }
+}
